{
  "name": "syncachu-api",
  "version": "1.0.0",
  "description": "Private, resumable media backup API",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "dist/src/functions.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "quota:init": "npm run build && node dist/src/initializeQuota.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build && func start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/functions": "4.16.2",
    "@azure/identity": "4.13.2",
    "@azure/storage-blob": "12.33.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
