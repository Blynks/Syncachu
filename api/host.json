{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Host.Results": "Warning",
      "Function": "Warning"
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxOutstandingRequests": 100,
      "maxConcurrentRequests": 20
    }
  },
  "functionTimeout": "00:30:00"
}
