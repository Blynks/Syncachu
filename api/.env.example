# Copy values into local.settings.json (Values) for Core Tools or Azure app settings.
# Core Tools does not automatically load this file.
# Allowlist BOTH ID-token audiences (aud) and authorized presenters (azp).
# Native hybrid sign-in can use the Web/server client as aud and a native
# Android/iOS OAuth client as azp. Include every trusted native client ID
# (including separate Android debug/release signing clients), plus the Web ID.
# azp is optional; when present, it must also appear in this explicit list.
GOOGLE_CLIENT_IDS=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com,YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com,YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
# Verified Google emails allowed to use this private instance. Empty fails closed.
ALLOWED_GOOGLE_EMAILS=you@example.com
AZURE_STORAGE_ACCOUNT_URL=https://YOUR_ACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER=media
AZURE_QUOTA_TABLE=syncachuquota
# Decimal 1 TB total across ALL approved accounts, not 1 TB per account.
STORAGE_QUOTA_BYTES=1000000000000
FUNCTIONS_WORKER_RUNTIME=node
FUNCTIONS_NODE_BLOCK_ON_ENTRY_POINT_ERROR=true
# Identity-based Functions host storage; no account keys or connection strings.
# The host account is separate from the media account and its RBAC:
# grant Storage Blob Data Owner on the HOST account to the local az login
# developer and to the deployed Function App managed identity.
# The reservation-expiry timer uses host Blob storage; quota accounting also needs
# Storage Table Data Contributor on the media quota table.
# Local startup: copy local.settings.example.json to local.settings.json,
# replace its placeholders, run az login, then npm ci && npm start.
# Leave __credential unset locally so Core Tools uses developer credentials.
AzureWebJobsStorage__accountName=YOUR_HOST_STORAGE_ACCOUNT
# Azure only: use the Function App's managed identity for host storage.
# AzureWebJobsStorage__credential=managedidentity
# For a user-assigned identity, also set AZURE_CLIENT_ID and host clientId.
# AZURE_CLIENT_ID=YOUR_MANAGED_IDENTITY_CLIENT_ID
# AzureWebJobsStorage__clientId=YOUR_MANAGED_IDENTITY_CLIENT_ID
